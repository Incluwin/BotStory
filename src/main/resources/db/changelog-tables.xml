    <!-- Preserve existing Agents by translating the former account sentinel into explicit identity rows. -->
    <changeSet id="38-backfill-agent-character-identity" author="Codex">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="agent_characters"/>
        </preConditions>
        <sql>
            INSERT INTO agent_characters
                (character_id, status, origin, interactive_allowed, created_at, updated_at)
            SELECT c.id, 'ACTIVE', 'LEGACY_BACKFILL', FALSE, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP
            FROM characters c
            JOIN accounts a ON a.id = c.accountid
            WHERE a.banned = 1
              AND a.banreason = 'Agent-only backing account'
              AND NOT EXISTS (
                  SELECT 1 FROM agent_characters identity_row
                  WHERE identity_row.character_id = c.id
              )
        </sql>
    </changeSet>

