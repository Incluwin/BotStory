# Project administration files
.idea
.git
.github

# Not used by the build.
docs
handbook
tools
installer
database-console
director-panel
video-assets
reports
tmp
v83 clean wz files

# Local tooling state: session worktrees (GBs), the code graph, a local Maven repository.
.claude
graphify-out
.m2

# Created by the db when using docker-compose, large and causes rebuild issues if sent to the context.
**/docker-db-data

# Local secrets and build/runtime output.
.env
sso-key.json
target
logs
.runtime
# The agents' navigation-graph cache a local server writes (hundreds of MB); the image never uses it.
cache
