# Local settings and secrets for this server. setup.bat copies this file to .env and fills in the
# database login; start-server.bat (Windows) and docker compose read .env. Never commit .env.

# --- Required: the MySQL login the server uses ---------------------------------------------------
# DB_USER/DB_PASS are read by tools.DatabaseConnection; config.yaml leaves DB_PASS blank on purpose.
# With docker compose, DB_PASS also becomes the root password of the MySQL container.
DB_USER=root
DB_PASS=

# --- Hosting players on other PCs (optional) -----------------------------------------------------
# Players on this PC need nothing. Each address below is what the server tells players of that kind
# to connect to; a blank value keeps config.yaml's 127.0.0.1.
#   SERVER_LANHOST: this PC's address on your home network (ipconfig: IPv4 Address), for LAN players
#   SERVER_HOST: your public IP, for players on the internet (forward TCP 8484 and 7575-7577)
#   SERVER_TAILSCALEHOST: this PC's Tailscale IP, for players on your tailnet
SERVER_LANHOST=
SERVER_HOST=
SERVER_TAILSCALEHOST=

# --- The game client (optional) ------------------------------------------------------------------
# Blank keeps config.yaml (both off). setup.bat sets MOD_FUSION_ANVIL=on when it is blank, for the
# client from installer/ (BotStory's launcher on your own Cosmic or Community Repack WZ files; with
# Docker, set it here yourself, as nothing else does); set it to off for a plain
# kaentake client, which closes on entering the game when it is on. Leave MOD_BOTSTORY_WZ off unless
# the client has BotStory's own WZ files: a client without them closes when a character wears its items.
#   MOD_FUSION_ANVIL: every equip carries its Fusion Anvil id, which only BotStory's DLL reads
#   MOD_BOTSTORY_WZ: characters get the Evolving Ring, and the Hunter's Codex is a cash medal
MOD_FUSION_ANVIL=
MOD_BOTSTORY_WZ=

# --- Optional services; everything below can stay as it is --------------------------------------

# TypeSafe System One (Jev) typed judgments. Every Jev feature stays off until a key is
# present AND its switch is enabled (AGENT_TYPESAFE_* in agent-engine.yaml,
# USE_TYPESAFE_* in config.yaml). Endpoint, model and timeout have sensible defaults.
TYPESAFE_API_KEY=
#TYPESAFE_ENDPOINT=https://api.typesafe.ai/v1/systemone
#TYPESAFE_MODEL=jev-latest
#TYPESAFE_TIMEOUT_MS=1500

# Generated replies for population citizens and companion small talk (server.agents.social).
# Without a reachable Ollama the deterministic catalog answers; DETERMINISTIC_ONLY never calls a model.
#SOCIAL_DIALOGUE_MODE=DIALOGUE_ONLY
#SOCIAL_OLLAMA_ENDPOINT=http://127.0.0.1:11434
#SOCIAL_OLLAMA_MODEL=qwen3.5:9b-q4_K_M

# ADMIN_CONTROL_TOKEN guards the loopback AdminControlPort (:8480) that the MapleEdit dashboard uses;
# 64 random characters. Blank = the port refuses every request.
ADMIN_CONTROL_TOKEN=

# Separate PostgreSQL economy evidence database (only for !economy runs and the economy dashboard);
# never reuse the MySQL credentials. docker compose --profile economy starts it.
ECONOMY_DB_PASSWORD=replace-with-a-long-random-password
ECONOMY_DB_HOST=127.0.0.1
ECONOMY_DB_PORT=5433
ECONOMY_DB_NAME=cosmic_economy
ECONOMY_DB_USER=economy

# The database console bridge is disabled unless explicitly enabled. If enabled,
# use a random token containing at least 32 characters.
COSMIC_DATABASE_CONSOLE_BRIDGE_ENABLED=false
COSMIC_BRIDGE_TOKEN=replace-with-at-least-32-random-characters

# Empty, non-scripted maps are unloaded after 30 idle minutes and rebuilt from WZ on demand.
COSMIC_MAPS_IDLEUNLOADENABLED=true
COSMIC_MAPS_IDLEUNLOADMILLIS=1800000
